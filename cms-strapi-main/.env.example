# development = Content-Type Builder editable (npm run develop)
# production  = locked schema (npm run start / npm run build)
NODE_ENV=development

HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Frontend origins allowed to call REST (comma-separated). Production: set explicit site origins only.
# Local defaults in config/middlewares.ts also include :5173 / :4173 when this env is unset.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# SQLite 文件（相对项目根目录）。本地和线上都应指向这份 Git 跟踪的库
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

