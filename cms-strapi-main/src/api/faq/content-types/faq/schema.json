{
  "kind": "collectionType",
  "collectionName": "faqs",
  "info": {
    "singularName": "faq",
    "pluralName": "faqs",
    "displayName": "常见问题",
    "description": "常见问题条目"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "moq",
        "formulation",
        "packaging",
        "compliance",
        "lead-time"
      ],
      "default": "moq"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
