{
  "kind": "singleType",
  "collectionName": "work_pages",
  "info": {
    "singularName": "work-page",
    "pluralName": "work-pages",
    "displayName": "作品页面配置",
    "description": "Work 频道页设置"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "intro": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featuredProjects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work-project.work-project"
    },
    "displayCategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work-category.work-category"
    },
    "showFeatured": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
