{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "关于我们",
    "description": "Marvlore About 文案与拼贴图（几何布局仍由前端控制）"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "brandName": {
      "type": "string",
      "default": "Marvlore",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "brandNameCn": {
      "type": "string",
      "default": "（迈络）",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "partnerLine": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "partnerLineCn": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.about-stat",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "collageImages": {
      "type": "component",
      "repeatable": true,
      "component": "shared.about-collage-image",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
